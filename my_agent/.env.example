# Copy this template to my_agent/.env for local production configuration.
# Never commit real keys. Normally configure only ARK_API_KEY.
ARK_API_KEY=
# Deprecated compatibility fallback; use ARK_API_KEY for new configuration.
SEEDREAM_API_KEY=
SEEDREAM_MODEL_ID=doubao-seedream-5-0-pro-260628
SEEDREAM_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
SEEDREAM_IMAGE_SIZE=1024x1536
SEEDREAM_WATERMARK=false
SEEDREAM_TIMEOUT_SECONDS=240
# Enable Seedream textless sequential posters + local text editor workflow.
ENABLE_SEEDREAM_PRODUCT_POSTER_SEQUENCE=true
# Optional legacy group workflow gate; leave empty unless explicitly enabled.
ENABLE_SEEDREAM_PRODUCT_POSTER_GROUP=

DEEPSEEK_API_KEY=
# Optional compatibility fallback for OpenAI-compatible copy providers.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com
CHAT_MODEL=deepseek-chat

PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

AD_API_BASE_URL=http://127.0.0.1:8000
AD_API_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://127.0.0.1:3000
# Configure a hosting volume path in a later deployment round; never use a personal path here.
AD_ARTIFACT_ROOT=
AD_MAX_UPLOAD_BYTES=10485760
AD_MAX_IMAGE_PIXELS=40000000
AD_MAX_PROVIDER_IMAGE_BYTES=26214400

# Local development remains unauthenticated unless a valid edge token is deliberately set.
AD_REQUIRE_EDGE_PROXY=false
# Render supplies this server-side secret; never expose it to browser code.
AD_EDGE_PROXY_TOKEN=
